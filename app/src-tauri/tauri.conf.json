{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tengen-tetris",
  "version": "0.1.0",
  "identifier": "dev.kilo.tengen-tetris",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "../tools/build_sidecar.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tengen Tetris",
        "width": 1400,
        "height": 1320,
        "minWidth": 800,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "externalBin": [
      "binaries/tetris-core"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
