{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "tengen-tetris",
  "version": "0.1.0",
  "identifier": "dev.kilo.tengen-tetris",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Tengen Tetris",
        "width": 1400,
        "height": 1320,
        "minWidth": 800,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
